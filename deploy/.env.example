# =============================================================================
# LexBridge 环境配置模板
# =============================================================================
# 用法：
#     cp deploy/.env.example deploy/.env
#     然后填入真实值。deploy/.env 已被 .gitignore 忽略，永远不会入库。
#
# 本项目是公开仓库。提交任何东西之前请自问：
#   这个文件里有没有真实的密钥、口令、Token？
# 仓库根的 .gitignore 已覆盖 .env / *.key / *.pem，但人的判断仍是最后一道闸。
#
# 一键演示不需要填任何密钥：MODEL_MODE 默认 replay，回放仓库内已录制的真实响应。
# 只有要用真实模型时才需要 SILICONFLOW_API_KEY。
# =============================================================================

# -----------------------------------------------------------------------------
# 演示账号
# -----------------------------------------------------------------------------
# true  : 首次启动时创建三个固定口令的演示账号。租户 demo-law / acme-law，
#         账号 admin / lawyer / compliance，口令 LexBridge@2026。
#         **公开演示部署需要它**——没有账号就没法登录，等于没交付。
# false : 不创建。**任何生产部署都必须设成 false。**
#
# 建的是固定口令账号，这在生产环境是严重的安全问题。代码侧还有
# @ConditionalOnProperty 兜底，两层重复是有意的：只靠"部署时记得关掉"迟早会忘。
DEMO_DATA=true

# -----------------------------------------------------------------------------
# LLM 调用模式 —— 三选一
# -----------------------------------------------------------------------------
# real   : 真实调用硅基流动。需要 SILICONFLOW_API_KEY，会产生费用。不写 fixture。
# record : 真实调用**并且**把响应录成 fixture。产出回放素材时用它——
#          它贵、慢、且会改动仓库内容，因此刻意与 real 分开，
#          不做成任何默认行为的一部分。
#          cd ai-service && MODEL_MODE=record uv run python ../scripts/demo_consult.py --record
# replay : 回放仓库内录制的真实响应（ai-service/fixtures/replay/）。
#          确定性、可离线、零成本。** docker compose up 的默认值。**
# mock   : 纯合成响应，行为可控但不反映真实模型输出。用于契约测试。
MODEL_MODE=replay

# -----------------------------------------------------------------------------
# 硅基流动（仅 MODEL_MODE=real 时需要）
# -----------------------------------------------------------------------------
# 获取：https://cloud.siliconflow.cn/account/ak
# 切勿把真实 key 写进本文件后提交——只提交占位符。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 模型 ID 经实测确证（见 docs/decision-record.md D-01）。
# 注意：deepseek-v4-flash 是产品名，不是 API 模型 ID，直接调用会 404。
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_MODEL_FALLBACK=deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# 批量与并发经实测选定（decision-record.md D-05/D-06）。
# 批量上限实测为 512（文档称 32，不准）；128×8 是唯一保持 100% 成功率的组合。
EMBEDDING_BATCH_SIZE=128
EMBEDDING_CONCURRENCY=8
# 冷启动实测波动 0.7s–65.9s，因此重试不是可选项。
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# LangSmith（可选；不填则关闭 trace）
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lexbridge
# 非 US 区必须显式指定，且末尾不能有斜杠
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# ⚠️ 端口约定：本文件里的端口一律是**宿主视角**的
# =============================================================================
# 这个文件有两类消费者，它们对端口的期待不同：
#
#   1. docker compose  —— 需要容器内端口（postgres:5432、redis:6379）
#   2. 本地直接运行     —— 需要宿主映射端口（127.0.0.1:5433、127.0.0.1:6380）
#
# 由于基础 compose 出于攻击面收敛不发布数据库与缓存端口，宿主侧访问依赖
# docker-compose.override.yml，它把 5432→5433、6379→6380（且只绑 127.0.0.1）。
#
# 解决方式是：**本文件写宿主视角的值，compose 里显式覆盖成容器内值**。
# compose 文件已经对 DB_URL 与 REDIS_HOST/REDIS_PORT 做了显式赋值，
# 因此不存在歧义。
#
# 踩过的坑：这里曾写成容器内端口 6379，结果本地启动的应用连不上 Redis，
# 表现为 actuator 整体健康 503 —— 而 /health/readiness 是 UP（数据库没问题），
# 错误信息完全不指向端口配置。
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=lexbridge
POSTGRES_USER=lexbridge
# 本地开发默认口令。生产环境必须更换。
POSTGRES_PASSWORD=lexbridge_dev_only
# 宿主端口：由 override 层映射，仅 127.0.0.1 可达
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# 应用侧连接（api 与 ai 使用同一角色，P2 会按 schema 拆分）
# -----------------------------------------------------------------------------
# ⚠️ 应用角色**刻意不是表 owner**：PostgreSQL 的 RLS 默认对表 owner 不生效，
#    若应用角色同时是 owner，多租户隔离会静默失效（见 docs/decision-record.md D-11）。
DB_USERNAME=lexbridge_app
DB_PASSWORD=lexbridge_dev_only

# -----------------------------------------------------------------------------
# 迁移凭据 —— 与上面**必须不同**
# -----------------------------------------------------------------------------
# Flyway 需要 ENABLE ROW LEVEL SECURITY / CREATE POLICY / CREATE RULE，
# 这些都要求表 owner 权限，应用角色没有。
#
# 两种混用的后果截然不同：
#   应用角色跑迁移 → DDL 权限不足，应用起不来（能发现）
#   迁移角色跑应用 → superuser 绕过全部 RLS，隔离静默失效（发现不了）
#
# 默认与 POSTGRES_USER 相同，即容器的超级用户。
MIGRATION_DB_USERNAME=lexbridge
MIGRATION_DB_PASSWORD=lexbridge_dev_only
# DB_URL 留空则由上面的分项组装（见 ai-service/app/core/config.py 的 dsn 属性）。
# 显式填时注意容器内外的主机名不同：容器内是 postgres:5432，宿主是 127.0.0.1:5433。
# 容器内的值由 compose 显式注入，这里不需要写。

# LangGraph 检查点表反序列化安全开关。
# 不开的话，数据库被攻陷时检查点反序列化可导致代码执行。
# 本项目仓库公开，此项必须为 true。
LANGGRAPH_STRICT_MSGPACK=true

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_HOST 与 REDIS_PORT 由 compose 显式覆盖为 redis:6379，
# 因此本文件只在本地直接运行服务时生效——此时应当指向宿主映射端口。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# 应用安全
# -----------------------------------------------------------------------------
# 以下三个密钥必须自行生成，不要使用任何示例值：
#   openssl rand -base64 48
JWT_SECRET=
INTERNAL_TOKEN_SECRET=
# JWT 有效期（分钟）
JWT_TTL_MINUTES=480

# -----------------------------------------------------------------------------
# 构建期镜像源（可选）
# -----------------------------------------------------------------------------
# 全部留空则走官方源，仓库在任何网络环境下都能构建。
#
# 但在部分网络环境（例如中国大陆直连）下，三个包管理器都可能极慢甚至
# **静默卡住**——进程还在、CPU 归零、没有任何错误输出。
# 这类「不是失败、只是不动」的状态最难判断，因此显式提供这三个开关。
#
# 典型配置（按需启用）：
#   MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
#   NPM_REGISTRY=https://registry.npmmirror.com
#   PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
MAVEN_MIRROR_URL=
NPM_REGISTRY=
PYPI_INDEX_URL=

# -----------------------------------------------------------------------------
# 服务端口与运行参数
# -----------------------------------------------------------------------------
WEB_PORT=80
API_PORT=8080
AI_PORT=8000
SPRING_PROFILES_ACTIVE=docker
# Java 21 虚拟线程承载长 SSE 连接
SPRING_THREADS_VIRTUAL_ENABLED=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 上传与解析
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/data/files
# 扫描件 PDF 不支持（无 OCR），会进入「待人工干预」队列
OCR_ENABLED=false
